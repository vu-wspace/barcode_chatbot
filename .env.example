POSTGRES_PASSWORD=change-me
# Only for running the BE outside Docker (compose gives the be container its own URL)
DATABASE_URL=postgresql://postgres:change-me@localhost:5433/barcode_chatbot
# LLM: OpenRouter is the main model, Gemini the fallback. Groq is configured but unused by the agent.
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
# Optional tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=barcode-chatbot
