POSTGRES_PASSWORD=change-me
# Least-privilege roles for be/ai, created by the migrate service (letters/digits only: they go into URLs)
BE_DB_PASSWORD=change-me-too
AI_DB_PASSWORD=change-me-three
# Only for running the BE outside Docker (compose gives the be container its own URL)
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5433/barcode_chatbot
# LLM: Gemini 3.1 Flash Lite is the main model; fallbacks in order: OpenRouter, NVIDIA, Gemini 3.5, Groq. NVIDIA/Groq keys are optional.
# Only these and LANGSMITH_* reach the ai container (see docker-compose.yml); other keys in this file do not.
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
# Optional tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=barcode-chatbot
# GATE_PORT=8080
# SEED_DEMO=true
